@startuml
title UF-01 - Acceder a la plataforma

skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  DiamondBackgroundColor #FFF7ED
  DiamondBorderColor #F59E0B
  StartColor #F59E0B
  EndColor #0F172A
}

start
:Abrir pantalla de inicio de sesión;
:Ingresar correo y contraseña;
if (¿Campos completos y formato válido?) then (Sí)
  :Enviar credenciales;
else (No)
  :Mostrar errores de validación;
  if (¿Corregir datos?) then (Sí)
    :Editar campos;
    :Enviar credenciales;
  else (Cancelar)
    stop
  endif
endif
if (¿Credenciales correctas?) then (Sí)
  if (¿Cuenta activa?) then (Sí)
    :Cargar rol y permisos;
    :Abrir dashboard correspondiente;
  else (No)
    :Informar cuenta suspendida o pendiente;
    :Mostrar canal de soporte;
  endif
else (No)
  :Mostrar mensaje de acceso inválido;
  if (¿Recuperar contraseña?) then (Sí)
    :Solicitar enlace de recuperación;
    :Confirmar envío al correo;
  else (Reintentar)
    :Volver al formulario conservando el correo;
  endif
endif
stop

@enduml
