@startuml
!include <C4/C4_Component>

title MaquiControl - Rental Management Bounded Context Component Diagram

Container(webapp, "Single Page Application", "Angular", "Provides the user interface through a web browser.")

Container_Boundary(rental, "Rental Management Bounded Context") {

    Component(interfaces, "RentalController", "Spring Boot @RestController", "Exposes GET, POST, PATCH /api/v1/rentals endpoints.")

    Component(application, "RentalApplicationService", "Spring Boot @Service", "Coordinates requestRental(), confirmRental(), cancelRental() and updateDates() use cases.")

    Component(domain, "Rental Aggregate", "Java Domain Entity", "Contains Rental aggregate root, RentalPeriod and Money value objects.")

    Component(infrastructure, "RentalRepository", "Spring Data JPA @Repository", "Provides persistence via save(), findById(), findByStatus() and findByContractorId().")

    Component(security, "SecurityConnector", "Spring Security Component", "Validates authenticated users and contractor permissions.")
}

ContainerDb(database, "Database", "Relational Database", "Stores rental and reservation information.")

Rel(webapp, interfaces, "Calls /api/v1/rentals/*", "HTTPS / JSON")
Rel(interfaces, application, "Calls requestRental() / confirmRental()")
Rel(application, domain, "Invokes confirm() / cancel() / calculateTotal()")
Rel(application, infrastructure, "Calls save() / findById()")
Rel(infrastructure, database, "Executes SQL queries")
Rel(interfaces, security, "Validates security context")

@enduml