@startuml
!include <C4/C4_Component>

title MaquiControl - Operations Management Bounded Context Component Diagram

Container(webapp, "Single Page Application", "Angular", "Provides the user interface through a web browser.")

Container_Boundary(operations, "Operations Management Bounded Context") {

    Component(interfaces, "ServiceOperationController", "Spring Boot @RestController", "Exposes GET, POST, PUT, PATCH /api/v1/service-operations endpoints.")

    Component(application, "OperationsApplicationService", "Spring Boot @Service", "Coordinates startService(), recordWorkedHours() and completeService() use cases.")

    Component(domain, "ServiceOperation Aggregate", "Java Domain Entity", "Contains ServiceOperation aggregate root, WorkedHours value object and status logic.")

    Component(infrastructure, "ServiceOperationRepository", "Spring Data JPA @Repository", "Provides persistence via save(), findById(), findByRentalId() and findByStatus().")

    Component(security, "SecurityConnector", "Spring Security Component", "Validates authenticated users and operational roles.")
}

ContainerDb(database, "Database", "Relational Database", "Stores service operation and worked-hour information.")

Rel(webapp, interfaces, "Calls /api/v1/service-operations/*", "HTTPS / JSON")
Rel(interfaces, application, "Calls startService() / recordWorkedHours()")
Rel(application, domain, "Invokes start() / recordHours() / complete()")
Rel(application, infrastructure, "Calls save() / findById()")
Rel(infrastructure, database, "Executes SQL queries")
Rel(interfaces, security, "Validates security context")

@enduml