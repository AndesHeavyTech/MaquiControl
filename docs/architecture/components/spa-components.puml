@startuml
!include <C4/C4_Component>

title MaquiControl - Single Page Application Component Diagram (Bounded Contexts)

Container(webServer, "Web Application", "Nginx", "Serves the compiled SPA to the browser.")

Container_Boundary(spa, "Single Page Application [Angular]") {
    Component(iam, "IamFeatureModule", "Angular Feature Module", "Coordinates authentication, registration and account security views.")
    Component(profiles, "ProfilesFeatureModule", "Angular Feature Module", "Coordinates profile view, contact editing and organization management.")
    Component(fleet, "FleetFeatureModule", "Angular Feature Module", "Coordinates machinery catalog, equipment forms and availability views.")
    Component(rental, "RentalFeatureModule", "Angular Feature Module", "Coordinates rental requests, reservation lists and contract management.")
    Component(maintenance, "MaintenanceFeatureModule", "Angular Feature Module", "Coordinates maintenance schedules, breakdown reporting and repair logs.")
    Component(operations, "OperationsFeatureModule", "Angular Feature Module", "Coordinates service execution tracking and worked-hour validation.")
    Component(shared, "SharedKernelModule", "Angular Shared Module", "Provides AppLayoutComponent, NavbarComponent, SessionStore and BaseHttpService.")
}

Container(api, "REST API", "Spring Boot / Java", "Provides the MaquiControl business capabilities.")

Rel(webServer, shared, "Serves compiled SPA", "HTTPS")
Rel(iam, shared, "Imports shared layout and session")
Rel(profiles, shared, "Imports shared layout and session")
Rel(fleet, shared, "Imports shared layout and session")
Rel(rental, shared, "Imports shared layout and session")
Rel(maintenance, shared, "Imports shared layout and session")
Rel(operations, shared, "Imports shared layout and session")

Rel(iam, api, "Dispatches /api/v1/auth/* requests", "HTTPS / JSON")
Rel(profiles, api, "Dispatches /api/v1/profiles/* requests", "HTTPS / JSON")
Rel(fleet, api, "Dispatches /api/v1/machinery/* requests", "HTTPS / JSON")
Rel(rental, api, "Dispatches /api/v1/rentals/* requests", "HTTPS / JSON")
Rel(maintenance, api, "Dispatches /api/v1/maintenance/* requests", "HTTPS / JSON")
Rel(operations, api, "Dispatches /api/v1/operations/* requests", "HTTPS / JSON")

@enduml
