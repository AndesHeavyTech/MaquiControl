@startuml
!include <C4/C4_Component>

title MaquiControl - Operations Management Frontend Component Diagram (DDD Layers)

Container_Boundary(operations, "Operations Management Bounded Context [Angular]") {
    Boundary(presentation, "Presentation Layer") {
        Component(serviceOperationComponent, "ServiceOperationComponent", "Angular Component", "Displays operational status and calls operationsStore.loadOperation() and completeOperation(id).")
        Component(workedHoursFormComponent, "WorkedHoursFormComponent", "Angular Component", "Captures hours worked form and calls operationsStore.submitWorkedHours(hoursData).")
    }
    Boundary(application, "Application Layer") {
        Component(operationsStore, "OperationsStore", "Angular Signals Store", "Coordinates operations state; exposes currentOperation(), recordHours() and completeOperation() signals.")
    }
    Boundary(domain, "Domain Layer") {
        Component(operationModel, "OperationModel", "TypeScript Interface / Class", "Defines operation domain model: id, rentalId, workedHours, operatorNotes and operationStatus.")
    }
    Boundary(infrastructure, "Infrastructure Layer") {
        Component(operationsApiService, "OperationsApiService", "Angular HttpClient Service", "Executes HTTP calls: getOperationStatus(), postWorkedHours() and patchOperationStatus().")
    }
}

Container(api, "REST API", "Spring Boot / Java", "Exposes /api/v1/operations endpoints.")

Rel(serviceOperationComponent, operationsStore, "Calls loadOperation() / completeOperation(id)")
Rel(workedHoursFormComponent, operationsStore, "Calls submitWorkedHours(hoursData)")
Rel(operationsStore, operationModel, "Instantiates and updates state")
Rel(operationsStore, operationsApiService, "Calls getOperationStatus() / postWorkedHours()")
Rel(operationsApiService, api, "Dispatches HTTP GET/POST/PATCH /api/v1/operations/*", "HTTPS / JSON")

@enduml
