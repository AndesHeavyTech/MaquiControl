@startuml
!include <C4/C4_Component>

title MaquiControl - Maintenance Management Bounded Context Component Diagram

Container(webapp, "Single Page Application", "Angular", "Provides the user interface through a web browser.")

Container_Boundary(maintenance, "Maintenance Management Bounded Context") {

    Component(interfaces, "Interfaces Layer", "Spring Web", "Exposes endpoints for maintenance management and breakdown reporting.")

    Component(application, "Application Layer", "Spring Boot", "Coordinates maintenance scheduling, completion and status update use cases.")

    Component(domain, "Domain Layer", "Java", "Contains the Maintenance aggregate and maintenance business rules.")

    Component(infrastructure, "Infrastructure Layer", "Spring Data JPA", "Provides persistence for maintenance records and history.")

    Component(security, "Security Connector", "Spring Security", "Validates authenticated users and permissions.")
}

ContainerDb(database, "Database", "Relational Database", "Stores maintenance and breakdown information.")

Rel(webapp, interfaces, "Uses", "HTTPS / JSON")
Rel(interfaces, application, "Invokes")
Rel(application, domain, "Uses")
Rel(application, infrastructure, "Uses")
Rel(infrastructure, database, "Reads from and writes to")
Rel(interfaces, security, "Validates access through")

@enduml