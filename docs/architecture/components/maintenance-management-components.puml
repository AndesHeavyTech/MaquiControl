@startuml
!include <C4/C4_Component>

title MaquiControl - Maintenance Management Bounded Context Component Diagram

Container(webapp, "Single Page Application", "Angular", "Provides the user interface through a web browser.")

Container_Boundary(maintenance, "Maintenance Management Bounded Context") {

    Component(interfaces, "MaintenanceController", "Spring Boot @RestController", "Exposes GET, POST, PUT /api/v1/maintenance endpoints.")

    Component(application, "MaintenanceApplicationService", "Spring Boot @Service", "Coordinates scheduleMaintenance(), reportBreakdown() and completeMaintenance() use cases.")

    Component(domain, "Maintenance Aggregate", "Java Domain Entity", "Contains Maintenance aggregate root, MaintenanceType and status business rules.")

    Component(infrastructure, "MaintenanceRepository", "Spring Data JPA @Repository", "Provides persistence via save(), findById(), findByMachineryId() and findByStatus().")

    Component(security, "SecurityConnector", "Spring Security Component", "Validates authenticated users and fleet administrator roles.")
}

ContainerDb(database, "Database", "Relational Database", "Stores maintenance and breakdown information.")

Rel(webapp, interfaces, "Calls /api/v1/maintenance/*", "HTTPS / JSON")
Rel(interfaces, application, "Calls scheduleMaintenance() / reportBreakdown()")
Rel(application, domain, "Invokes complete() / reschedule() / updateNotes()")
Rel(application, infrastructure, "Calls save() / findById()")
Rel(infrastructure, database, "Executes SQL queries")
Rel(interfaces, security, "Validates security context")

@enduml