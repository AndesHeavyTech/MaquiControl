@startuml
!include <C4/C4_Component>

title MaquiControl - Shared Frontend Component Diagram (DDD Layers)

Container_Boundary(shared, "Shared Kernel [Angular]") {
    Boundary(presentation, "Presentation Layer") {
        Component(layout, "AppLayoutComponent", "Angular Component", "Hosts the application shell layout, router outlet and footer structure.")
        Component(navigation, "NavbarComponent", "Angular Component", "Provides role-aware navigation bar; calls sessionStore.clearSession() on sign out.")
        Component(feedback, "NotificationToastComponent", "Angular Component", "Displays system alerts, loading spinners and error feedback notifications.")
    }
    Boundary(application, "Application Layer") {
        Component(sessionStore, "SessionStore", "Angular Signals Store", "Coordinates global session state; exposes currentUser(), userRole() and clearSession().")
    }
    Boundary(domain, "Domain Layer") {
        Component(sharedModel, "SharedDomainModel", "TypeScript Types / Interfaces", "Defines shared domain structures: Money, DateRange, PageResponse and EntityId.")
    }
    Boundary(infrastructure, "Infrastructure Layer") {
        Component(apiClient, "BaseHttpService", "Angular HttpClient Service", "Provides base HTTP request methods: get(), post(), put() and delete().")
        Component(authInterceptor, "AuthInterceptor", "Angular HttpInterceptorFn", "Implements intercept(req, next) injecting Bearer JWT headers.")
    }
}

Container(api, "REST API", "Spring Boot / Java", "MaquiControl backend endpoints.")

Rel(layout, navigation, "Renders <app-navbar>")
Rel(layout, feedback, "Renders <app-notification-toast>")
Rel(navigation, sessionStore, "Reads currentUser() and userRole()")
Rel(sessionStore, sharedModel, "Holds and validates session data")
Rel(apiClient, authInterceptor, "Intercepted by intercept(req, next)")
Rel(authInterceptor, api, "Dispatches authorized HTTP requests", "HTTPS / JSON")

@enduml
