@startuml
!include <C4/C4_Component>

title MaquiControl - Profiles Management Frontend Component Diagram (DDD Layers)

Container_Boundary(profiles, "Profiles Management Bounded Context [Angular]") {
    Boundary(presentation, "Presentation Layer") {
        Component(profileViewComponent, "ProfileViewComponent", "Angular Component", "Displays user profile and calls profileStore.loadProfile() and updateProfile(data).")
        Component(organizationFormComponent, "OrganizationFormComponent", "Angular Component", "Captures organization data and calls profileStore.setOrganization(orgData).")
    }
    Boundary(application, "Application Layer") {
        Component(profileStore, "ProfileStore", "Angular Signals Store", "Coordinates profile state; exposes profile(), updateProfile() and setOrganization() signals.")
    }
    Boundary(domain, "Domain Layer") {
        Component(profileModel, "ProfileModel", "TypeScript Interface / Class", "Defines user profile domain model: id, fullName, email, phone and organization details.")
    }
    Boundary(infrastructure, "Infrastructure Layer") {
        Component(profilesApiService, "ProfilesApiService", "Angular HttpClient Service", "Executes HTTP calls: getProfile(id), putProfile(data) and postOrganization(data).")
    }
}

Container(api, "REST API", "Spring Boot / Java", "Exposes /api/v1/profiles endpoints.")

Rel(profileViewComponent, profileStore, "Calls loadProfile() / updateProfile(data)")
Rel(organizationFormComponent, profileStore, "Calls setOrganization(orgData)")
Rel(profileStore, profileModel, "Instantiates and updates state")
Rel(profileStore, profilesApiService, "Calls getProfile() / putProfile()")
Rel(profilesApiService, api, "Dispatches HTTP GET/PUT /api/v1/profiles/*", "HTTPS / JSON")

@enduml
