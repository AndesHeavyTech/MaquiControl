@startuml
!include <C4/C4_Component>

title MaquiControl - Identity & Access Management Bounded Context Component Diagram

Container(webapp, "Single Page Application", "Angular", "Provides the user interface through a web browser.")

Container_Boundary(iam, "Identity & Access Management Bounded Context") {

    Component(interfaces, "AuthController", "Spring Boot @RestController", "Exposes POST /api/v1/authentication/sign-in and POST /api/v1/authentication/sign-up endpoints.")

    Component(application, "IdentityAccessService", "Spring Boot @Service", "Coordinates authenticateUser(), registerUser(), assignRole() and changePassword() use cases.")

    Component(domain, "UserAccount Aggregate", "Java Domain Entity", "Contains UserAccount aggregate root, Credential value object, Role entity and status logic.")

    Component(infrastructure, "UserAccountRepository", "Spring Data JPA @Repository", "Provides persistence via save(), findById(), findByEmail() and existsByEmail().")

    Component(security, "SecurityFilterChain", "Spring Security Component", "Applies JwtTokenFilter to validate Bearer tokens and permissions.")
}

ContainerDb(database, "Database", "Relational Database", "Stores user account, credential and role information.")

Rel(webapp, interfaces, "Calls /api/v1/authentication/*", "HTTPS / JSON")
Rel(interfaces, application, "Calls authenticateUser() / registerUser()")
Rel(application, domain, "Invokes authenticate() / register()")
Rel(application, infrastructure, "Calls save() / findByEmail()")
Rel(infrastructure, database, "Executes SQL queries")
Rel(interfaces, security, "Validates security context")

@enduml