@startuml
!include <C4/C4_Component>

title MaquiControl - Maintenance Management Frontend Component Diagram (DDD Layers)

Container_Boundary(maintenance, "Maintenance Management Bounded Context [Angular]") {
    Boundary(presentation, "Presentation Layer") {
        Component(maintenanceScheduleComponent, "MaintenanceScheduleComponent", "Angular Component", "Renders maintenance calendar and calls maintenanceStore.loadSchedule() and scheduleMaintenance(data).")
        Component(breakdownReportComponent, "BreakdownReportComponent", "Angular Component", "Captures incident form data and calls maintenanceStore.reportBreakdown(breakdownData).")
    }
    Boundary(application, "Application Layer") {
        Component(maintenanceStore, "MaintenanceStore", "Angular Signals Store", "Coordinates maintenance state; exposes schedule(), scheduleMaintenance(), reportBreakdown() and completeMaintenance().")
    }
    Boundary(domain, "Domain Layer") {
        Component(maintenanceModel, "MaintenanceModel", "TypeScript Interface / Class", "Defines maintenance domain model: id, machineryId, scheduledDate, maintenanceType, status and notes.")
    }
    Boundary(infrastructure, "Infrastructure Layer") {
        Component(maintenanceApiService, "MaintenanceApiService", "Angular HttpClient Service", "Executes HTTP calls: getMaintenanceSchedule(), postScheduleMaintenance() and postBreakdownReport().")
    }
}

Container(api, "REST API", "Spring Boot / Java", "Exposes /api/v1/maintenance endpoints.")

Rel(maintenanceScheduleComponent, maintenanceStore, "Calls loadSchedule() / scheduleMaintenance(data)")
Rel(breakdownReportComponent, maintenanceStore, "Calls reportBreakdown(breakdownData)")
Rel(maintenanceStore, maintenanceModel, "Instantiates and updates state")
Rel(maintenanceStore, maintenanceApiService, "Calls getMaintenanceSchedule() / postScheduleMaintenance()")
Rel(maintenanceApiService, api, "Dispatches HTTP GET/POST /api/v1/maintenance/*", "HTTPS / JSON")

@enduml
