@startuml
!include <C4/C4_Component>

title MaquiControl - Profiles Management Bounded Context Component Diagram

Container(webapp, "Single Page Application", "Angular", "Provides the user interface through a web browser.")

Container_Boundary(profiles, "Profiles Management Bounded Context") {

    Component(interfaces, "ProfileController", "Spring Boot @RestController", "Exposes GET, PUT /api/v1/profiles and POST /api/v1/profiles/organization endpoints.")

    Component(application, "ProfileApplicationService", "Spring Boot @Service", "Coordinates viewProfile(), updateProfile() and registerOrganization() use cases.")

    Component(domain, "Profile Aggregate", "Java Domain Entity", "Contains Profile aggregate root, ContactInformation and Organization value objects.")

    Component(infrastructure, "ProfileRepository", "Spring Data JPA @Repository", "Provides persistence via save(), findById(), findByEmail() and existsByUserId().")

    Component(security, "SecurityConnector", "Spring Security Component", "Validates authenticated user identity.")
}

ContainerDb(database, "Database", "Relational Database", "Stores profile, contact and organization information.")

Rel(webapp, interfaces, "Calls /api/v1/profiles/*", "HTTPS / JSON")
Rel(interfaces, application, "Calls viewProfile() / updateProfile()")
Rel(application, domain, "Invokes updateContact() / updateOrganization()")
Rel(application, infrastructure, "Calls save() / findById()")
Rel(infrastructure, database, "Executes SQL queries")
Rel(interfaces, security, "Validates security context")

@enduml