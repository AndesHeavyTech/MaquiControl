@startuml
!include <C4/C4_Component>

title MaquiControl - Fleet Management Bounded Context Component Diagram

Container(webapp, "Single Page Application", "Angular", "Provides the user interface through a web browser.")

Container_Boundary(fleet, "Fleet Management Bounded Context") {

    Component(interfaces, "MachineryController", "Spring Boot @RestController", "Exposes GET, POST, PUT /api/v1/machinery endpoints.")

    Component(application, "FleetApplicationService", "Spring Boot @Service", "Coordinates registerMachinery(), updateMachinery() and checkAvailability() use cases.")

    Component(domain, "Machinery Aggregate", "Java Domain Entity", "Contains Machinery aggregate root, MachineryLocation and Money value objects.")

    Component(infrastructure, "MachineryRepository", "Spring Data JPA @Repository", "Provides persistence via save(), findById(), findByStatus() and findAll().")

    Component(security, "SecurityConnector", "Spring Security Component", "Validates authenticated users and administrative roles.")
}

ContainerDb(database, "Database", "Relational Database", "Stores machinery and fleet information.")

Rel(webapp, interfaces, "Calls /api/v1/machinery/*", "HTTPS / JSON")
Rel(interfaces, application, "Calls registerMachinery() / updateMachinery()")
Rel(application, domain, "Invokes updateStatus() / updateLocation()")
Rel(application, infrastructure, "Calls save() / findById()")
Rel(infrastructure, database, "Executes SQL queries")
Rel(interfaces, security, "Validates security context")

@enduml