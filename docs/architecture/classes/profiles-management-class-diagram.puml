@startuml
title MaquiControl - Profiles Management Bounded Context\nClass Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam linetype ortho
hide empty members

package "Profiles Management" {

  class Profile <<Aggregate Root>> {
    - id: UUID
    - userAccountId: UUID
    - firstName: String
    - lastName: String
    - documentNumber: String
    - contactInformation: ContactInformation
    - organization: Organization
    - createdAt: LocalDateTime
    - updatedAt: LocalDateTime
    + create(): void
    + updatePersonalInformation(firstName: String, lastName: String, documentNumber: String): void
    + updateContactInformation(contact: ContactInformation): void
    + updateOrganizationInformation(organization: Organization): void
    + fullName(): String
  }

  class ContactInformation <<Value Object>> {
    - phoneNumber: String
    - secondaryEmail: String
    - address: String
    - district: String
    - city: String
    + isValid(): Boolean
    + formattedAddress(): String
  }

  class Organization <<Entity>> {
    - id: UUID
    - legalName: String
    - tradeName: String
    - taxId: String
    - type: OrganizationType
    - address: String
    + updateInformation(legalName: String, tradeName: String, address: String): void
    + isValidTaxId(): Boolean
  }

  enum OrganizationType {
    INDEPENDENT_CONTRACTOR
    RENTAL_COMPANY
    CONSTRUCTION_COMPANY
    OTHER
  }

  interface ProfileRepository {
    + save(profile: Profile): Profile
    + findById(id: UUID): Optional<Profile>
    + findByUserAccountId(userAccountId: UUID): Optional<Profile>
    + findByDocumentNumber(documentNumber: String): Optional<Profile>
    + existsByDocumentNumber(documentNumber: String): Boolean
  }

  class ProfilesManagementService <<Application Service>> {
    - profileRepository: ProfileRepository
    + createProfile(profile: Profile): Profile
    + updateProfileInformation(id: UUID, firstName: String, lastName: String, documentNumber: String): Profile
    + updateContactInformation(id: UUID, contact: ContactInformation): Profile
    + updateOrganizationInformation(id: UUID, organization: Organization): Profile
    + viewProfile(id: UUID): Profile
    + viewContactInformation(id: UUID): ContactInformation
    + viewOrganizationInformation(id: UUID): Organization
  }
}

Profile "1" *-- "1" ContactInformation : contains >
Profile "1" o-- "0..1" Organization : belongs to >
Organization --> OrganizationType : classified as >
ProfilesManagementService "1" --> "1" ProfileRepository : uses >
ProfileRepository ..> Profile : persists >

legend right
  |= Symbol |= Meaning |
  | + | Public |
  | - | Private |
  | *-- | Composition |
  | o-- | Aggregation |
  | --> | Association |
  | ..> | Dependency |
endlegend

@enduml