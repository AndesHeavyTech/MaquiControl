@startuml
title MaquiControl - Rental Management Bounded Context\nClass Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam linetype ortho
hide empty members

package "Rental Management" {

  class Rental <<Aggregate Root>> {
    - id: Long
    - machineryId: Long
    - contractorProfileId: Long
    - period: RentalPeriod
    - status: RentalStatus
    - totalAmount: Money
    - requestedAt: LocalDateTime
    - confirmedAt: LocalDateTime
    - cancelledAt: LocalDateTime
    + request(): void
    + confirm(): void
    + cancel(reason: String): void
    + updateDates(period: RentalPeriod): void
    + calculateTotal(hourlyRate: Money): Money
    + isActive(): Boolean
  }

  class RentalPeriod <<Value Object>> {
    - startDate: LocalDate
    - endDate: LocalDate
    + durationInDays(): Long
    + overlaps(other: RentalPeriod): Boolean
    + isValid(): Boolean
  }

  class Money <<Value Object>> {
    - amount: BigDecimal
    - currency: Currency
    + add(other: Money): Money
    + multiply(factor: BigDecimal): Money
    + isNonNegative(): Boolean
  }

  enum Currency {
    PEN
    USD
  }

  enum RentalStatus {
    REQUESTED
    CONFIRMED
    IN_PROGRESS
    COMPLETED
    CANCELLED
  }

  interface RentalRepository {
    + save(rental: Rental): Rental
    + findById(id: Long): Optional<Rental>
    + findByContractorProfileId(profileId: Long): List<Rental>
    + findByMachineryId(machineryId: Long): List<Rental>
    + findByStatus(status: RentalStatus): List<Rental>
    + existsOverlappingRental(machineryId: Long, period: RentalPeriod): Boolean
  }

  class RentalManagementService <<Application Service>> {
    - rentalRepository: RentalRepository
    + requestRental(rental: Rental): Rental
    + confirmReservation(id: Long): Rental
    + cancelReservation(id: Long, reason: String): Rental
    + updateRentalDates(id: Long, period: RentalPeriod): Rental
    + viewRentalRequests(): List<Rental>
    + viewMyReservations(profileId: Long): List<Rental>
    + checkReservationDetails(id: Long): Rental
  }
}

Rental "1" *-- "1" RentalPeriod : contains >
Rental "1" *-- "1" Money : total >
Money --> Currency : expressed in >
Rental --> RentalStatus : has >
RentalManagementService "1" --> "1" RentalRepository : uses >
RentalRepository ..> Rental : persists >

legend right
  |= Symbol |= Meaning |
  | + | Public |
  | - | Private |
  | *-- | Composition |
  | --> | Association |
  | ..> | Dependency |
endlegend

@enduml
