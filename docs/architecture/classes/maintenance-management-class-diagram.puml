@startuml
title MaquiControl - Maintenance Management Bounded Context\nClass Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam linetype ortho
hide empty members

package "Maintenance Management" {

  class Maintenance <<Aggregate Root>> {
    - id: Long
    - machineryId: Long
    - type: MaintenanceType
    - status: MaintenanceStatus
    - description: String
    - scheduledDate: LocalDateTime
    - startedAt: LocalDateTime
    - completedAt: LocalDateTime
    - technicianName: String
    - cost: Money
    - breakdownReports: List<BreakdownReport>
    + schedule(): void
    + start(): void
    + complete(cost: Money): void
    + updateStatus(status: MaintenanceStatus): void
    + reportBreakdown(report: BreakdownReport): void
    + isPending(): Boolean
  }

  class BreakdownReport <<Entity>> {
    - id: Long
    - description: String
    - severity: BreakdownSeverity
    - reportedAt: LocalDateTime
    - resolvedAt: LocalDateTime
    - resolved: Boolean
    + resolve(): void
    + isCritical(): Boolean
  }

  class Money <<Value Object>> {
    - amount: BigDecimal
    - currency: Currency
    + add(other: Money): Money
    + isNonNegative(): Boolean
  }

  enum Currency {
    PEN
    USD
  }

  enum MaintenanceType {
    PREVENTIVE
    CORRECTIVE
    INSPECTION
  }

  enum MaintenanceStatus {
    SCHEDULED
    IN_PROGRESS
    COMPLETED
    CANCELLED
  }

  enum BreakdownSeverity {
    LOW
    MEDIUM
    HIGH
    CRITICAL
  }

  interface MaintenanceRepository {
    + save(maintenance: Maintenance): Maintenance
    + findById(id: Long): Optional<Maintenance>
    + findByMachineryId(machineryId: Long): List<Maintenance>
    + findByStatus(status: MaintenanceStatus): List<Maintenance>
    + findCompletedByMachineryId(machineryId: Long): List<Maintenance>
  }

  class MaintenanceManagementService <<Application Service>> {
    - maintenanceRepository: MaintenanceRepository
    + scheduleMaintenance(maintenance: Maintenance): Maintenance
    + completeMaintenance(id: Long, cost: Money): Maintenance
    + reportBreakdown(id: Long, report: BreakdownReport): Maintenance
    + updateMaintenanceStatus(id: Long, status: MaintenanceStatus): Maintenance
    + viewMaintenanceHistory(machineryId: Long): List<Maintenance>
    + viewPendingMaintenance(): List<Maintenance>
    + checkMaintenanceDetails(id: Long): Maintenance
  }
}

Maintenance "1" *-- "0..*" BreakdownReport : contains >
Maintenance "1" *-- "0..1" Money : cost >
Money --> Currency : expressed in >
Maintenance --> MaintenanceType : classified as >
Maintenance --> MaintenanceStatus : has >
BreakdownReport --> BreakdownSeverity : has >
MaintenanceManagementService "1" --> "1" MaintenanceRepository : uses >
MaintenanceRepository ..> Maintenance : persists >

legend right
  |= Symbol |= Meaning |
  | + | Public |
  | - | Private |
  | *-- | Composition |
  | --> | Association |
  | ..> | Dependency |
endlegend

@enduml
