@startuml
title MaquiControl - Fleet Management Bounded Context\nClass Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam linetype ortho
hide empty members

package "Fleet Management" {

  class Machinery <<Aggregate Root>> {
    - id: Long
    - ownerProfileId: Long
    - categoryId: Long
    - name: String
    - description: String
    - brand: String
    - model: String
    - year: Integer
    - hourlyRate: Money
    - status: MachineryStatus
    - location: MachineryLocation
    - createdAt: LocalDateTime
    - updatedAt: LocalDateTime
    + register(): void
    + updateInformation(name: String, description: String, hourlyRate: Money): void
    + changeStatus(status: MachineryStatus): void
    + updateLocation(location: MachineryLocation): void
    + classifyAs(category: Category): void
    + isAvailable(): Boolean
  }

  class Category <<Entity>> {
    - id: Long
    - code: String
    - name: String
    - active: Boolean
    + rename(name: String): void
    + deactivate(): void
  }

  class MachineryLocation <<Value Object>> {
    - department: String
    - province: String
    - district: String
    - address: String
    - latitude: Double
    - longitude: Double
    + fullAddress(): String
    + isValid(): Boolean
  }

  class Money <<Value Object>> {
    - amount: BigDecimal
    - currency: Currency
    + add(other: Money): Money
    + multiply(factor: BigDecimal): Money
    + isNonNegative(): Boolean
  }

  enum Currency {
    PEN
    USD
  }

  enum MachineryStatus {
    AVAILABLE
    RESERVED
    RENTED
    IN_MAINTENANCE
    OUT_OF_SERVICE
  }

  interface MachineryRepository {
    + save(machinery: Machinery): Machinery
    + findById(id: Long): Optional<Machinery>
    + findAll(): List<Machinery>
    + findAvailable(): List<Machinery>
    + findByCategoryId(categoryId: Long): List<Machinery>
    + existsById(id: Long): Boolean
  }

  interface CategoryRepository {
    + save(category: Category): Category
    + findById(id: Long): Optional<Category>
    + findAllActive(): List<Category>
    + existsById(id: Long): Boolean
  }

  class FleetManagementService <<Application Service>> {
    - machineryRepository: MachineryRepository
    - categoryRepository: CategoryRepository
    + registerMachinery(machinery: Machinery): Machinery
    + updateMachineryInformation(id: Long, name: String, description: String, hourlyRate: Money): Machinery
    + updateMachineryStatus(id: Long, status: MachineryStatus): Machinery
    + registerCategory(category: Category): Category
    + updateCategory(id: Long, name: String): Category
    + viewMachineryInventory(): List<Machinery>
    + viewCategories(): List<Category>
    + checkMachineryAvailability(id: Long): Boolean
  }
}

Machinery "1" *-- "1" MachineryLocation : contains >
Machinery "1" *-- "1" Money : hourly rate >
Machinery "0..*" --> "1" Category : classified as >
Money --> Currency : expressed in >
Machinery --> MachineryStatus : has >
FleetManagementService "1" --> "1" MachineryRepository : uses >
FleetManagementService "1" --> "1" CategoryRepository : uses >
MachineryRepository ..> Machinery : persists >
CategoryRepository ..> Category : persists >

legend right
  |= Symbol |= Meaning |
  | + | Public |
  | - | Private |
  | *-- | Composition |
  | --> | Association |
  | ..> | Dependency |
endlegend

@enduml
